  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node -e \"console.log('aggregate: nothing to build')\""
  },
  "dependencies": {
    "@javenlu233/dsh-session-cost": "workspace:^",
    "@javenlu233/dsh-client-ui-turn-cost": "workspace:^"
  },
  "files": [
    "cordis.patch.yml"
  ]
}
